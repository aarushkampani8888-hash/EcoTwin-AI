TIGER_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: lower Gemini reasoning time, e.g. low
GEMINI_THINKING_LEVEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

POLL_SECONDS=2
RECENT_WINDOW=10 minutes
BASELINE_WINDOW=1 hour
INCIDENT_COOLDOWN=15 minutes
FRAMES_DIR=frames
AUDIO_DIR=audio

# Play each broadcast out loud as soon as it's generated (macOS)
AUTOPLAY=true

# Closed loop: an OPEN incident becomes RESOLVED after this long at safe levels.
# Use something short like "1 minute" when demoing live.
RESOLUTION_WINDOW=10 minutes

# Pattern memory lives in Tiger Data (agent_memory table) by default.
# Optional: set a Backboard key to use Backboard's memory API instead.
BACKBOARD_API_KEY=
# Optional: reuse a specific assistant's memory. Otherwise one is created on first
# run and its id saved to .backboard_assistant_id
BACKBOARD_ASSISTANT_ID=
PATTERN_WINDOW_DAYS=30
PATTERN_MIN_PRIOR=2

# Solana bounty on resolution.
#   mock   = nothing sent anywhere (default)
#   devnet = real transaction on Solana devnet with free test SOL (run solana_setup.py first)
SOLANA_MODE=mock
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: send devnet bounties to your own devnet wallet address (e.g. Phantom on devnet).
# Leave empty to use the generated .solana_crew.json wallet.
BOUNTY_RECIPIENT_WALLET=
